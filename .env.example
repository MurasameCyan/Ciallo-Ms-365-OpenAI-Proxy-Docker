# Admin password for the /admin console (optional, falls back to API_KEY)
# /admin 运营总控台密码（可选，未设置时回退使用 API_KEY）
ADMIN_PASSWORD=


# Legacy/global API Key for /v1/ quick start. Set your own secret key.
# For multi-user usage, create per-user API keys in the /admin console.
# If no keys are registered and this is empty, all /v1/ endpoints are open without auth.
# 兼容/快速启动用的全局 API Key。请设置你自己的密钥。
# 多用户场景请在 /admin 总控台创建并绑定每用户 API Key。
# 若一个 Key 都没注册且此项留空，则 /v1/ 端点无认证开放。
API_KEY=